{
  "name": "@stacksjs/ts-xml",
  "type": "module",
  "version": "0.1.1",
  "description": "A fast, dependency-free XML parser, builder, and validator for TypeScript & Bun.",
  "author": "Chris Breuer <chris@stacksjs.com>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/ts-xml#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-xml.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/ts-xml/issues"
  },
  "keywords": [
    "xml",
    "parser",
    "builder",
    "validator",
    "typescript",
    "bun",
    "fast",
    "zero-dependency"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun --bun build.ts && bun run compile",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "prepublishOnly": "bun --bun run build",
    "bench": "bun run benchmarks/index.ts",
    "test": "bun test",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "changelog": "bunx logsmith --verbose",
    "changelog:generate": "bunx logsmith --output CHANGELOG.md",
    "release": "bunx --bun bumpx prompt --recursive",
    "postinstall": "bunx git-hooks",
    "dev:docs": "bun --bun bunpress dev docs",
    "build:docs": "bun --bun bunpress build docs",
    "preview:docs": "bun --bun bunpress preview docs",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "bunx --bun pickier . --format",
    "format:fix": "bunx --bun pickier . --format --write"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/sax": "^1.2.7",
    "@types/xml2js": "^0.4.14",
    "better-dx": "^0.2.15",
    "fast-xml-parser": "^5.5.3",
    "mitata": "^1.0.34",
    "sax": "^1.5.0",
    "xml2js": "^0.6.2"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      },
      "autoRestage": true
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
